# Dependencies
node_modules

# Build output
dist
coverage
*.tsbuildinfo

# Emitted artefacts must only ever live in dist/. A misconfigured project once
# dropped .d.ts files next to the scripts they were generated from, and `vue-tsc
# --build` later did the same to ui/ — the emitted vite.config.js then shadowed
# the .ts one and broke the build. Both projects are checked here so the junk
# cannot be committed even when a tool starts producing it again.
/scripts/**/*.js
/scripts/**/*.d.ts
/scripts/**/*.map
/ui/**/*.js
/ui/**/*.d.ts
/ui/**/*.map

# Playwright run artefacts. The screenshots under docs/ui-review/ are kept on
# purpose — they are the review page — but traces and failure dumps are not.
ui/e2e/.artifacts
ui/playwright-report

# Environment
.env
.env.local
!.env.example
!.env.test

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# The assignment brief — kept locally, not part of the submission.
*.pdf
