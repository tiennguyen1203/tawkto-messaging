{
  "name": "techbank-messaging-api",
  "private": true,
  "version": "1.0.0",
  "description": "Message management API — NestJS, MongoDB, Kafka, Elasticsearch",
  "license": "MIT",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "pnpm build && node dist/main",
    "start:dev": "pnpm build && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & TSA=$!; trap 'kill $TSA 2>/dev/null' EXIT INT TERM; tsc-alias -p tsconfig.build.json --watch & node --watch dist/main)",
    "start:debug": "pnpm build && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & TSC=$!; trap 'kill $TSC 2>/dev/null' EXIT INT TERM; node --watch --inspect dist/main)",
    "start:prod": "node dist/main",
    "start:consumer": "pnpm build && node dist/main.consumer",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --fix",
    "test": "APP_ENV=test jest --config jest.json --forceExit",
    "test:watch": "APP_ENV=test jest --config jest.json --watch",
    "test:cov": "APP_ENV=test jest --config jest.json --coverage",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:create": "migrate-mongo create",
    "debezium:register": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node -r tsconfig-paths/register scripts/register-debezium.ts",
    "debezium:status": "curl -s ${KAFKA_CONNECT_URL:-http://localhost:8083}/connectors/messaging-message-connector/status",
    "es:apply-templates": "TS_NODE_PROJECT=tsconfig.scripts.json ts-node -r tsconfig-paths/register scripts/apply-es-templates.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.2",
    "@keyv/redis": "5.1.4",
    "@nestjs/cache-manager": "3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@typegoose/typegoose": "^12.11.0",
    "cache-manager": "7.2.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.5.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "keyv": "^5.6.0",
    "lodash": "^4.17.21",
    "migrate-mongo": "^12.1.3",
    "mongodb": "^6.20.0",
    "mongoose": "8.21.0",
    "nestjs-cls": "6.2.0",
    "nestjs-pino": "4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^9.8.0",
    "@jest/globals": "^29.7.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@suites/di.nestjs": "3.0.1",
    "@suites/doubles.jest": "3.0.1",
    "@suites/unit": "3.0.1",
    "@testcontainers/elasticsearch": "^12.1.0",
    "@testcontainers/mongodb": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/superagent": "^8.1.11",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "pino-pretty": "13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "pnpm@11.5.1"
}
