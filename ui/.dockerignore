# The build context is this directory, so this file is what trims it — the
# repository's .dockerignore does not apply here.
#
# node_modules matters most. A pnpm modules directory records the store it came
# from; copied in from the host it points at a store the image does not have, and
# pnpm then tries to purge it, asks for confirmation, finds no TTY, and the build
# dies with ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY.
node_modules
dist

.git
.DS_Store
*.log

# Emitted by an earlier `vue-tsc --build` and never wanted in an image.
*.tsbuildinfo
