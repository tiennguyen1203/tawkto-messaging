APP_ENV=local

# Host ports for docker-compose. Defaults avoid the usual 27017/6379 so this
# stack can run alongside other projects.
MONGO_HOST_PORT=27018
REDIS_HOST_PORT=6380
PORT=3000
LOG_LEVEL=debug

# Single-node replica set — required for change streams (the CDC source).
MONGO_URI=mongodb://localhost:27018/messaging?replicaSet=rs0&directConnection=true

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=
REDIS_PASSWORD=

# Must be at least 32 characters.
# Identity runs as its own process on its own port.
IDENTITY_PORT=3001

# Host port for the demo client container. Not 8080: too many things already
# answer there, and a page served by someone else's project is a confusing bug.
DEMO_UI_PORT=8088

# Host port for the Elasticsearch UI.
ELASTICVUE_PORT=8089

JWT_SECRET=change-me-to-a-32-character-secret-value

# Wired up in M2/M3.
# Kafka publishes 9094 to the host; 9092 is the in-compose listener that only
# other containers can reach. A consumer run with pnpm needs the external one.
KAFKA_BROKERS=localhost:9094
KAFKA_CONSUMER_GROUP=message-search-indexer
KAFKA_CONNECT_URL=http://localhost:8083
ELASTICSEARCH_NODE=http://localhost:9200
