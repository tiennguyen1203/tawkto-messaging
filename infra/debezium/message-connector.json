{
  "_comment": [
    "The topic name and partition count are deliberately absent: scripts/register-debezium.ts",
    "injects them from KafkaTopic / MESSAGE_CREATED_PARTITIONS so the wire contract has a",
    "single source of truth and cannot drift from the consumer.",
    "Registered with: pnpm debezium:register"
  ],
  "name": "messaging-message-connector",
  "config": {
    "connector.class": "io.debezium.connector.mongodb.MongoDbConnector",
    "mongodb.connection.string": "mongodb://mongo:27017/?replicaSet=rs0",
    "topic.prefix": "messaging",

    "database.include.list": "messaging",
    "collection.include.list": "messaging.messages",

    "capture.mode": "change_streams_update_full",
    "snapshot.mode": "no_data",

    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",

    "transforms": "unwrap,rekey,extractKey,route",

    "transforms.unwrap.type": "io.debezium.connector.mongodb.transforms.ExtractNewDocumentState",
    "transforms.unwrap.delete.tombstone.handling.mode": "rewrite",

    "transforms.rekey.type": "org.apache.kafka.connect.transforms.ValueToKey",
    "transforms.rekey.fields": "conversationId",

    "transforms.extractKey.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.extractKey.field": "conversationId",

    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "messaging\\.messaging\\.messages",

    "topic.creation.enable": "true",
    "topic.creation.default.replication.factor": "1"
  }
}
