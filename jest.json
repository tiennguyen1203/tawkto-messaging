{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "transform": {
    "^.+\\.[tj]s$": [
      "ts-jest",
      {
        "tsconfig": "./tsconfig.spec.json"
      }
    ]
  },
  "moduleFileExtensions": [
    "ts",
    "js"
  ],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/$1"
  },
  "rootDir": "src",
  "globalSetup": "<rootDir>/shared/test/jest-setups/global-setup.ts",
  "globalTeardown": "<rootDir>/shared/test/jest-setups/global-teardown.ts",
  "testTimeout": 30000
}