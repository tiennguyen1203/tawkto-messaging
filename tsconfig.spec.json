{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/out-tsc",
    "module": "commonjs",
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
    },
    "typeRoots": [
      "./node_modules/@types",
      "src/shared/typings"
    ]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/shared/typings/*.d.ts"
  ]
}
